          "valid_timing_count": 24,
          "last_timestamp_seconds": 180.0,
          "sample_text": "招牌 店名 下一集 敬請期待"
        },
        {"template": "ja", "track_index": 6}
      ],
      "expected_strategy": "TRANSLATE_JA_SUBTITLE",
      "expected_subtitle_track": 6
    },
    {
      "name": "metadata_wrong_content_japanese",
      "subtitles": [
        {"template": "ja", "track_index": 7, "container_language_tag": "zh-CN"}
