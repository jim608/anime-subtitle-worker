    {
      "name": "metadata_missing_traditional_content",
      "subtitles": [
        {"template": "zh_tw", "track_index": 8, "container_language_tag": "und"}
      ],
      "expected_strategy": "NORMALIZE_ZH_HANT",
      "expected_subtitle_track": 8
