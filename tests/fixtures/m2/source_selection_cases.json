  "cases": [
    {
      "name": "complete_traditional_chinese",
      "subtitles": [{"template": "zh_tw", "track_index": 0}],
      "expected_strategy": "USE_EXISTING_ZH_TW",
      "expected_subtitle_track": 0
    },
    {
      "name": "complete_simplified_chinese",
      "subtitles": [{"template": "zh_cn", "track_index": 1}],
      "expected_strategy": "CONVERT_ZH_CN",
      "expected_subtitle_track": 1
    },
    {
      "name": "complete_japanese",
      "subtitles": [{"template": "ja", "track_index": 2}],
      "expected_strategy": "TRANSLATE_JA_SUBTITLE",
      "expected_subtitle_track": 2
    },
    {
      "name": "chinese_and_japanese_subtitles",
      "subtitles": [
        {"template": "ja", "track_index": 3},
        {"template": "zh_tw", "track_index": 4}
      ],
      "expected_strategy": "USE_EXISTING_ZH_TW",
      "expected_subtitle_track": 4
    },
    {
